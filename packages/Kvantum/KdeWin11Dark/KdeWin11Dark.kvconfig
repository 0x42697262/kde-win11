[%General]
author=0x42697262
comment=Windows 11 style controls and menus for Kvantum, generated by kde-win11
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
composite=true
splitter_width=1
scroll_min_extent=36
scroll_arrows=false
transient_scrollbar=true
transient_groove=true
center_toolbar_handle=true
toolbar_interior_spacing=4
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=true
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
animate_states=true
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing=6
scrollbar_in_view=true
submenu_overlap=0
spread_menuitems=false
menu_separator_height=9
tooltip_delay=-1
menu_shadow_depth=10
tooltip_shadow_depth=6
scroll_width=12
slider_width=4
slider_handle_width=20
slider_handle_length=20
tickless_slider_handle_size=20
progressbar_thickness=4
check_size=18

[GeneralColors]
window.color=#202020
base.color=#1c1c1c
alt.base.color=#262626
button.color=#2d2d2d
light.color=#2d2d2d
mid.light.color=#323232
dark.color=#9a9a9a
mid.color=#323232
highlight.color=#73b5e7
inactive.highlight.color=#73b5e7
text.color=#ffffff
window.text.color=#ffffff
button.text.color=#ffffff
disabled.text.color=#717171
tooltip.text.color=#ffffff
highlight.text.color=#000000
link.color=#99ebff
link.visited.color=#c7a6ff
progress.indicator.text.color=#ffffff

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
blur_translucent=true
respect_darkness=true
disabled_icon_opacity=70
iconless_menu=false
iconless_pushbutton=true
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
no_selection_tint=true
transparent_arrow_button=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=button
indicator.size=12
indicator.element=b-arrow
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#c8c8c8
text.toggle.color=#000000
text.shadow=0
text.margin=0
text.iconspacing=8
text.margin.top=2
text.margin.bottom=2
text.margin.left=8
text.margin.right=8
frame.expansion=0
min_width=+0.3font

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolbarButton]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.toggle.color=#ffffff
focusRectElement=tfocus

[ToolbarComboBox]
inherits=PanelButtonCommand
indicator.element=b-arrow

[ToolbarLineEdit]
frame.element=tlineedit
interior.element=tlineedit

[Dock]
inherits=PanelButtonCommand
frame.element=dock
interior.element=dock
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=s-arrow

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.toggle.color=#ffffff

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.toggle.color=#ffffff

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
indicator.element=flat-s-arrow

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=b-arrow

[IndicatorArrow]
indicator.element=arrow
indicator.size=12

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.toggle.color=#ffffff
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.left=16
text.margin.right=16
min_width=+0.5font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
text.toggle.color=#ffffff

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=none

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior.element=toolbar
indicator.element=none

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.press.color=#ffffff
text.toggle.color=#ffffff
min_height=0

[Splitter]
inherits=PanelButtonCommand
frame=false
interior.element=splitter
indicator.element=none

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
indicator.element=none

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=10
text.margin.right=10
min_height=30

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
interior=true
interior.element=menubar
frame.element=menubar
text.toggle.color=#ffffff
min_height=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[ComboBox]
inherits=PanelButtonCommand
indicator.element=b-arrow

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.normal.color=#ffffff

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.bold=true

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin=2

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
