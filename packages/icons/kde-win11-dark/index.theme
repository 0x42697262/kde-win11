[Icon Theme]
Name=Windows 11 Dark
Comment=Fluent UI System Icons and original Windows 11 style artwork
Inherits=kde-win11,breeze-dark,hicolor
Example=folder
FollowsColorScheme=true
DesktopDefault=48
ToolbarDefault=22
MainToolbarDefault=22
SmallDefault=16
PanelDefault=48
DialogDefault=32
